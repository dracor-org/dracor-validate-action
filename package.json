{
  "name": "dracor-validate-action",
  "description": "Github action validating TEI files",
  "version": "0.0.0",
  "author": "Carsten Milling <cmil@hashtable.de>",
  "private": true,
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/dracor-org/dracor-validate-action#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dracor-org/dracor-validate-action.git"
  },
  "bugs": {
    "url": "https://github.com/dracor-org/dracor-validate-action/issues"
  },
  "keywords": [
    "actions",
    "xml",
    "TEI",
    "setup"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "bundle": "pnpm run format:write && pnpm run package",
    "ci-test": "vitest run --coverage",
    "coverage": "make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "package": "rolldown -c rolldown.config.ts",
    "package:watch": "pnpm run package -- --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "all": "pnpm run format:write && pnpm run lint && pnpm run typecheck && pnpm run ci-test && pnpm run coverage && pnpm run package"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^2.0.0",
    "@actions/github": "^9.1.1",
    "@actions/glob": "^0.5.1",
    "@xmldom/xmldom": "^0.8.11",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.9.5",
    "prettier-eslint": "^16.4.2",
    "rolldown": "^1.2.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
